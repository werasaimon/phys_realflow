// Measured mechanism in selected late frames, not an assertion about every trajectory.
digraph split_energy {
    graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", fontsize=14,
        label="Поздняя цепь: измеренный механизм коррекции поз\n2026-10-01", labelloc=t,
        nodesep=0.35, ranksep=0.4];
    node [shape=box, style="rounded,filled", fillcolor="#edf4fb", color="#2166ac",
        fontname="DejaVu Sans", fontsize=12, margin="0.12,0.08"];
    edge [color="#52514e", fontname="DejaVu Sans", fontsize=10];
    overlap [label="Малое превышение slop\nконтакты несут вес"];
    split [label="Split-решатель\nпарные псевдоимпульсы"];
    pose [label="Коррекция позы\nбез прямого изменения v, ω"];
    energy [label="Высота меняется → U меняется\nΔU = −Σ m g·δx", fillcolor="#fff0e8", color="#d6604d"];
    measured [label="Кадр 785: ΔE = +159.47 мкДж\nЛокальный вклад split в U: +1.69231 мДж\nостальные изменения частично компенсируют", fillcolor="#fff0e8", color="#d6604d"];
    cache [label="Наблюдение кэша:\nодна старая точка назначается нескольким новым\nпричинный вклад ещё не изолирован", fillcolor="#f4f4f4", color="#777777"];
    overlap -> split -> pose -> energy -> measured;
    cache -> split [style=dashed, label="гипотеза для отдельного A/B"];
}
